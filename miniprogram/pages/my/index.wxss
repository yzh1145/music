.my {
  padding-top: 26rpx;
}

/* ==================== 用户卡片 ==================== */
.user-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx 10rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #d81e1e 0%, #a70f0f 55%, #7d1329 100%);
  box-shadow: 0 10rpx 30rpx rgba(160, 20, 20, 0.25);
  color: #ffffff;
}

.user-glow {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.user-main {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.15);
}

.info {
  flex: 1;
  min-width: 0;
}

.nickname {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
}

.username {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
}

.signature {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
}

.edit-btn {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 22rpx;
}

.stats {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 18rpx 0 24rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 21rpx;
}

.stat-line {
  width: 1rpx;
  height: 42rpx;
  background: rgba(255, 255, 255, 0.24);
}

/* ==================== 菜单 ==================== */
.menu {
  margin-top: 26rpx;
  padding: 6rpx 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
}

.menu-item + .menu-item {
  border-top: 1rpx solid #f5f5f7;
}

.menu-hover {
  opacity: 0.7;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
}

.menu-label {
  flex: 1;
  color: #333333;
  font-size: 28rpx;
}

.logout-btn {
  margin-top: 40rpx;
  padding: 24rpx 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #ec4141;
  font-size: 28rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* ==================== 未登录 ==================== */
.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 44rpx 46rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
}

.logo {
  width: 130rpx;
  height: 130rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 20, 20, 0.24);
}

.login-title {
  margin-top: 26rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.login-sub {
  margin-top: 12rpx;
  color: #999999;
  font-size: 23rpx;
  text-align: center;
  line-height: 1.6;
}

.login-btn {
  width: 100%;
  margin-top: 40rpx;
}

.register-btn {
  width: 100%;
  margin-top: 18rpx;
}

.demo-tip {
  margin-top: 28rpx;
  color: #b0b0b6;
  font-size: 21rpx;
  text-align: center;
  line-height: 1.6;
}

.version {
  margin-top: 50rpx;
  padding-bottom: 20rpx;
  color: #b8b8be;
  font-size: 20rpx;
  text-align: center;
}
