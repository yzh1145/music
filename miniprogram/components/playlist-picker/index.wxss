.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 700;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.picker-panel {
  padding: 24rpx 0 12rpx;
  padding-bottom: 12rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx 18rpx;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
}

.picker-close {
  color: #999999;
  font-size: 24rpx;
}

.create-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}

.create-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: #fdecec;
  color: #ec4141;
  font-size: 38rpx;
}

.create-text {
  color: #ec4141;
  font-size: 27rpx;
}

.picker-list {
  max-height: 52vh;
}

.loading-text,
.empty-text {
  padding: 50rpx 0;
  color: #999999;
  font-size: 24rpx;
  text-align: center;
}

.item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 28rpx;
}

.item-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: #eeeeee;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  display: block;
  color: #333333;
  font-size: 27rpx;
}

.item-sub {
  display: block;
  margin-top: 4rpx;
  color: #999999;
  font-size: 21rpx;
}

.item-add {
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  border: 1rpx solid #ec4141;
  border-radius: 24rpx;
  color: #ec4141;
  font-size: 23rpx;
}
