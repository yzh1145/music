<view class="page profile-page">
  <view class="card form-card">
    <view class="avatar-row">
      <image class="avatar" src="{{avatarPreview}}" mode="aspectFill" />
      <view class="avatar-info">
        <text class="avatar-title">头像</text>
        <text class="avatar-tip">支持 /images/xxx.png 或完整 https 地址</text>
      </view>
    </view>

    <view class="field">
      <text class="label">头像地址</text>
      <input class="input" value="{{form.avatar}}" placeholder="/images/avatar/u1.png" placeholder-class="ph" bindinput="onAvatarInput" />
    </view>

    <view class="field">
      <text class="label">昵称</text>
      <input class="input" value="{{form.nickname}}" maxlength="20" placeholder="请输入昵称" placeholder-class="ph" bindinput="onNicknameInput" />
    </view>

    <picker mode="selector" range="{{genders}}" value="{{form.gender}}" bindchange="onGenderChange">
      <view class="field">
        <text class="label">性别</text>
        <view class="picker-value">
          <text>{{genders[form.gender] || '保密'}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </picker>

    <picker mode="date" value="{{form.birthday || '2000-01-01'}}" start="1940-01-01" end="{{today}}" bindchange="onBirthdayChange">
      <view class="field">
        <text class="label">生日</text>
        <view class="picker-value">
          <text class="{{form.birthday ? '' : 'ph'}}">{{form.birthday || '未设置'}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </picker>

    <view class="field clear-birthday" wx:if="{{form.birthday}}">
      <text class="label"></text>
      <text class="clear-link" bindtap="clearBirthday">清除生日</text>
    </view>

    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" value="{{form.phone}}" maxlength="20" placeholder="选填" placeholder-class="ph" bindinput="onPhoneInput" />
    </view>

    <view class="field">
      <text class="label">邮箱</text>
      <input class="input" value="{{form.email}}" maxlength="50" placeholder="选填" placeholder-class="ph" bindinput="onEmailInput" />
    </view>

    <view class="field field-column">
      <text class="label">个性签名</text>
      <textarea
        class="textarea"
        value="{{form.signature}}"
        maxlength="255"
        placeholder="介绍一下自己"
        placeholder-class="ph"
        bindinput="onSignatureInput"
      />
    </view>

    <view class="btn btn-primary btn-block save-btn {{saving ? 'is-disabled' : ''}}" bindtap="saveProfile">
      {{saving ? '保存中…' : '保存资料'}}
    </view>
  </view>

  <view class="card form-card">
    <view class="card-head">
      <text class="card-title">修改密码</text>
      <text class="card-sub">修改成功后需要重新登录</text>
    </view>

    <view class="field">
      <text class="label">原密码</text>
      <input class="input" password="{{true}}" value="{{oldPassword}}" placeholder="请输入原密码" placeholder-class="ph" bindinput="onOldPasswordInput" />
    </view>

    <view class="field">
      <text class="label">新密码</text>
      <input class="input" password="{{true}}" value="{{newPassword}}" maxlength="20" placeholder="6-20 位" placeholder-class="ph" bindinput="onNewPasswordInput" />
    </view>

    <view class="field">
      <text class="label">确认密码</text>
      <input class="input" password="{{true}}" value="{{confirmPassword}}" maxlength="20" placeholder="再次输入新密码" placeholder-class="ph" bindinput="onConfirmPasswordInput" />
    </view>

    <view class="btn btn-soft btn-block {{savingPassword ? 'is-disabled' : ''}}" bindtap="savePassword">
      {{savingPassword ? '提交中…' : '修改密码'}}
    </view>
  </view>

  <view class="logout-btn" bindtap="onLogout">退出登录</view>

  <player-bar />
</view>
