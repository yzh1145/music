.singer-page {
  padding-top: 24rpx;
}

.loading {
  padding: 120rpx 0;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

/* ==================== 头部 ==================== */
.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 26rpx;
  border-radius: 24rpx;
  background: #2b2b2b;
  color: #ffffff;
}

.hero-bg {
  position: absolute;
  top: -60rpx;
  left: -60rpx;
  width: 140%;
  height: 140%;
  filter: blur(20px) brightness(0.5) saturate(1.2);
}

.hero-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.55));
}

.hero-body {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 36rpx 36rpx;
}

.avatar {
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.12);
}

.name {
  margin-top: 22rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.type {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 21rpx;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx 20rpx;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
}

.intro {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.follow-btn {
  margin-top: 24rpx;
  padding: 14rpx 46rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 34rpx;
  background: #ec4141;
  color: #ffffff;
  font-size: 26rpx;
}

.follow-btn.followed {
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.85);
}

/* ==================== 歌曲 ==================== */
.panel {
  padding: 18rpx 12rpx 20rpx;
  margin-bottom: 30rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 12rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
}

.play-all {
  color: #ec4141;
  font-size: 24rpx;
}

/* ==================== 专辑 ==================== */
.album-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26rpx 20rpx;
  margin-top: 22rpx;
}

.album {
  min-width: 0;
}

.album-cover {
  width: 100%;
  height: 210rpx;
  border-radius: 12rpx;
  background: #eeeeee;
}

.album-name {
  display: block;
  margin-top: 10rpx;
  color: #333333;
  font-size: 24rpx;
}

.album-meta {
  display: block;
  margin-top: 4rpx;
  color: #999999;
  font-size: 19rpx;
}
