.detail {
  padding-top: 24rpx;
}

.loading {
  padding: 120rpx 0;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

/* ==================== 头部 ==================== */
.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 26rpx;
  border-radius: 24rpx;
  background: #2b2b2b;
  color: #ffffff;
}

.hero-bg {
  position: absolute;
  top: -60rpx;
  left: -60rpx;
  width: 140%;
  height: 140%;
  filter: blur(15px) brightness(0.5) saturate(1.2);
  opacity: 0.9;
}

.hero-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(160deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.5));
}

.hero-body {
  position: relative;
  display: flex;
  gap: 26rpx;
  padding: 30rpx;
}

.hero-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #444444;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.35);
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-type {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 21rpx;
}

.tag-white {
  padding: 0 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 30rpx;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.creator {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 21rpx;
}

.creator-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.2);
}

.creator-name {
  max-width: 200rpx;
}

.create-time {
  color: rgba(255, 255, 255, 0.6);
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 16rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.category {
  padding: 2rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 20rpx;
}

.hero-intro {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 21rpx;
  line-height: 1.6;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.on-dark {
  border-color: rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

/* ==================== 歌曲列表 ==================== */
.panel {
  padding: 18rpx 12rpx 20rpx;
}

.panel-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 0 12rpx 12rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
}

.panel-count {
  color: #999999;
  font-size: 22rpx;
}

/* ==================== 弹层 ==================== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 700;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.sheet {
  padding: 26rpx 28rpx 20rpx;
  padding-bottom: 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-close {
  color: #999999;
  font-size: 24rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f5f5f7;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
}

.ph {
  color: #b0b0b6;
  font-size: 25rpx;
}

.search-action {
  color: #ec4141;
  font-size: 25rpx;
}

.candidates {
  max-height: 52vh;
  margin-top: 12rpx;
}

.candidate {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 4rpx;
}

.candidate + .candidate {
  border-top: 1rpx solid #f5f5f7;
}

.candidate-cover {
  width: 76rpx;
  height: 76rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: #eeeeee;
}

.candidate-info {
  flex: 1;
  min-width: 0;
}

.candidate-name {
  display: block;
  color: #333333;
  font-size: 26rpx;
}

.candidate-singer {
  display: block;
  margin-top: 4rpx;
  color: #999999;
  font-size: 21rpx;
}

.candidate-add {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border: 1rpx solid #ec4141;
  border-radius: 24rpx;
  color: #ec4141;
  font-size: 22rpx;
}

.sheet-empty {
  padding: 50rpx 0;
  color: #999999;
  font-size: 24rpx;
  text-align: center;
}

.edit-sheet {
  padding-bottom: 26rpx;
  padding-bottom: calc(26rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(26rpx + env(safe-area-inset-bottom));
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #666666;
  font-size: 24rpx;
}

.field-input,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f7f7f9;
  color: #333333;
  font-size: 26rpx;
}

.field-textarea {
  height: 180rpx;
  line-height: 1.6;
}

.sheet-footer {
  display: flex;
  gap: 18rpx;
  margin-top: 10rpx;
}
