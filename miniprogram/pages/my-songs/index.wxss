.songs-page {
  padding-top: 26rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.head-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.head-title {
  font-size: 38rpx;
  font-weight: 700;
}

.head-count {
  color: #999999;
  font-size: 22rpx;
}

.head-actions {
  display: flex;
  gap: 12rpx;
}

.panel {
  padding: 10rpx;
}

.loading {
  padding: 120rpx 0;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}
