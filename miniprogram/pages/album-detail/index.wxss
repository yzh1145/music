.album-page {
  padding-top: 24rpx;
}

.loading {
  padding: 120rpx 0;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

/* ==================== 头部 ==================== */
.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 26rpx;
  border-radius: 24rpx;
  background: #2b2b2b;
  color: #ffffff;
}

.hero-bg {
  position: absolute;
  top: -60rpx;
  left: -60rpx;
  width: 140%;
  height: 140%;
  filter: blur(20px) brightness(0.5) saturate(1.2);
}

.hero-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.55));
}

.hero-body {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 36rpx 36rpx;
}

.cover {
  width: 240rpx;
  height: 240rpx;
  border-radius: 18rpx;
  background: #444444;
  box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, 0.4);
}

.name {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
  word-break: break-all;
}

.type {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 21rpx;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx 20rpx;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
}

.link {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.3);
}

.intro {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.play-all {
  margin-top: 26rpx;
  padding: 14rpx 50rpx;
  border-radius: 34rpx;
  background: #ec4141;
  color: #ffffff;
  font-size: 26rpx;
}

/* ==================== 歌曲 ==================== */
.panel {
  padding: 18rpx 12rpx 20rpx;
}

.panel-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  padding: 0 12rpx 12rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
}

.panel-count {
  color: #999999;
  font-size: 22rpx;
}
