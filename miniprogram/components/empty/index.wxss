.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f5f5f5;
  color: #d5d5d9;
  font-size: 56rpx;
}

.text {
  margin-top: 22rpx;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

.slot {
  margin-top: 26rpx;
}
