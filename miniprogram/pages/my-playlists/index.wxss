.my-playlists {
  padding-top: 26rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.head-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.head-title {
  font-size: 38rpx;
  font-weight: 700;
}

.head-count {
  color: #999999;
  font-size: 22rpx;
}

.loading {
  padding: 120rpx 0;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 34rpx 20rpx;
}

.hint {
  margin-top: 40rpx;
  color: #b0b0b6;
  font-size: 21rpx;
  text-align: center;
}

/* ==================== 弹层 ==================== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 700;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.sheet {
  padding: 26rpx 28rpx;
  padding-bottom: 26rpx;
  padding-bottom: calc(26rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-close {
  color: #999999;
  font-size: 24rpx;
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #666666;
  font-size: 24rpx;
}

.field-input,
.field-textarea,
.field-picker {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f7f7f9;
  color: #333333;
  font-size: 26rpx;
}

.field-textarea {
  height: 170rpx;
  line-height: 1.6;
}

.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ph {
  color: #b0b0b6;
  font-size: 25rpx;
}

.sheet-footer {
  display: flex;
  gap: 18rpx;
  margin-top: 10rpx;
}
