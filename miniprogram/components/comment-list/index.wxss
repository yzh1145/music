.comment-list {
  margin-top: 8rpx;
}

/* ==================== 发表评论 ==================== */
.editor {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
}

.editor-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eeeeee;
}

.editor-main {
  flex: 1;
  min-width: 0;
}

.editor-textarea {
  width: 100%;
  min-height: 130rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #fafafa;
  color: #333333;
  font-size: 26rpx;
  line-height: 1.6;
}

.placeholder {
  color: #b8b8be;
  font-size: 26rpx;
}

.editor-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.count {
  color: #999999;
  font-size: 22rpx;
}

.submit-btn {
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  background: #ec4141;
  color: #ffffff;
  font-size: 24rpx;
}

.submit-btn.is-loading {
  background: #f3a5a5;
}

/* ==================== 评论项 ==================== */
.items {
  margin-top: 12rpx;
}

.loading-text,
.empty-tip {
  padding: 60rpx 0;
  color: #999999;
  font-size: 24rpx;
  text-align: center;
}

.comment {
  display: flex;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eeeeee;
}

.body {
  flex: 1;
  min-width: 0;
}

.head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nickname {
  color: #666666;
  font-size: 25rpx;
  font-weight: 500;
}

.time {
  color: #b0b0b6;
  font-size: 20rpx;
}

.content {
  display: block;
  margin: 10rpx 0 12rpx;
  color: #333333;
  font-size: 27rpx;
  line-height: 1.7;
  word-break: break-all;
}

.actions {
  display: flex;
  align-items: center;
  gap: 30rpx;
  color: #999999;
  font-size: 22rpx;
}

.action {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.action.liked {
  color: #ec4141;
}

/* ==================== 回复编辑框 ==================== */
.reply-editor {
  margin-top: 16rpx;
}

.reply-textarea {
  width: 100%;
  min-height: 100rpx;
  padding: 14rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  background: #f7f7f9;
  color: #333333;
  font-size: 25rpx;
  line-height: 1.6;
}

.reply-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 12rpx;
}

.reply-btn {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #e4e4e8;
  color: #666666;
  font-size: 23rpx;
}

.reply-btn.primary {
  border-color: #ec4141;
  background: #ec4141;
  color: #ffffff;
}

/* ==================== 二级回复 ==================== */
.replies {
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: #fafafa;
}

.reply {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 0;
}

.reply + .reply {
  border-top: 1rpx dashed #ececef;
}

.reply-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eeeeee;
}

.reply-body {
  flex: 1;
  min-width: 0;
}

.reply-content {
  display: block;
  margin: 6rpx 0 8rpx;
  color: #444444;
  font-size: 25rpx;
  line-height: 1.6;
  word-break: break-all;
}

.load-more {
  padding: 30rpx 0 10rpx;
  color: #ec4141;
  font-size: 25rpx;
  text-align: center;
}
