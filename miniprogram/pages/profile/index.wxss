.profile-page {
  padding-top: 26rpx;
}

.form-card {
  padding: 28rpx 26rpx;
  margin-bottom: 26rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding-bottom: 22rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #f5f5f7;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eeeeee;
}

.avatar-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.avatar-title {
  font-size: 30rpx;
  font-weight: 600;
}

.avatar-tip {
  color: #999999;
  font-size: 21rpx;
}

.field {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid #f7f7f9;
}

.field:last-child {
  border-bottom: none;
}

.field-column {
  flex-direction: column;
  align-items: stretch;
  padding: 18rpx 0;
}

.label {
  width: 150rpx;
  flex-shrink: 0;
  color: #666666;
  font-size: 26rpx;
}

.input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  color: #333333;
  font-size: 27rpx;
  text-align: right;
}

.ph {
  color: #b8b8be;
  font-size: 25rpx;
}

.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  color: #333333;
  font-size: 27rpx;
}

.textarea {
  width: 100%;
  height: 170rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f7f7f9;
  color: #333333;
  font-size: 26rpx;
  line-height: 1.6;
}

.clear-birthday {
  min-height: 60rpx;
}

.clear-link {
  color: #ec4141;
  font-size: 23rpx;
}

.save-btn {
  margin-top: 26rpx;
}

.card-head {
  margin-bottom: 10rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
}

.card-sub {
  display: block;
  margin-top: 6rpx;
  color: #999999;
  font-size: 21rpx;
}

.logout-btn {
  margin-top: 10rpx;
  padding: 24rpx 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #ec4141;
  font-size: 28rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.is-disabled {
  opacity: 0.65;
}
