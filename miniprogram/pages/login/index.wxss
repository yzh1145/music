.login-page {
  min-height: 100vh;
  padding: 70rpx 40rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #c20c0c 0%, #a30d16 34%, #f6f6f6 34.1%, #f6f6f6 100%);
}

.login-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 44rpx;
  color: #ffffff;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 26rpx rgba(80, 0, 0, 0.35);
}

.brand {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.slogan {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
}

.login-card {
  padding: 30rpx 28rpx;
}

.tabs {
  display: flex;
  gap: 40rpx;
  margin-bottom: 14rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.tab {
  position: relative;
  padding: 10rpx 4rpx 20rpx;
  color: #999999;
  font-size: 30rpx;
}

.tab.active {
  color: #333333;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 48rpx;
  height: 5rpx;
  margin-left: -24rpx;
  border-radius: 3rpx;
  background: #ec4141;
}

.field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f5f5f7;
}

.label {
  width: 150rpx;
  flex-shrink: 0;
  color: #666666;
  font-size: 26rpx;
}

.input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  color: #333333;
  font-size: 27rpx;
}

.ph {
  color: #b8b8be;
  font-size: 25rpx;
}

.submit {
  margin-top: 34rpx;
}

.demo {
  margin-top: 30rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed #f0f0f2;
}

.demo-title {
  display: block;
  color: #b0b0b6;
  font-size: 21rpx;
}

.demo-row {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.demo-chip {
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  background: #fdecec;
  color: #ec4141;
  font-size: 22rpx;
}

.skip {
  display: block;
  margin-top: 46rpx;
  color: #999999;
  font-size: 24rpx;
  text-align: center;
}

.is-disabled {
  opacity: 0.65;
}
