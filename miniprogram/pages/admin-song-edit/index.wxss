.edit-page {
  padding-top: 26rpx;
}

.loading {
  padding: 140rpx 0;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

.form-card {
  padding: 8rpx 26rpx;
  margin-bottom: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f7f7f9;
}

.field:last-child {
  border-bottom: none;
}

.field-column {
  flex-direction: column;
  align-items: stretch;
  padding: 20rpx 0;
}

.label {
  width: 170rpx;
  flex-shrink: 0;
  color: #666666;
  font-size: 26rpx;
}

.input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  color: #333333;
  font-size: 26rpx;
  text-align: right;
}

.ph {
  color: #b8b8be;
  font-size: 24rpx;
}

.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  color: #333333;
  font-size: 26rpx;
}

.switch-value {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.cover-preview {
  width: 140rpx;
  height: 140rpx;
  margin: 10rpx 0 18rpx 170rpx;
  border-radius: 12rpx;
  background: #eeeeee;
}

.textarea {
  width: 100%;
  height: 380rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f7f7f9;
  color: #333333;
  font-size: 24rpx;
  line-height: 1.7;
}

.lyric {
  height: 460rpx;
}

.save-btn {
  margin-top: 10rpx;
}

.hint {
  margin-top: 24rpx;
  padding-bottom: 20rpx;
  color: #999999;
  font-size: 21rpx;
  line-height: 1.7;
}

.is-disabled {
  opacity: 0.65;
}
