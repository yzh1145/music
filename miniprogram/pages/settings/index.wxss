.settings-page {
  padding-top: 26rpx;
}

.section-card {
  padding: 26rpx;
  margin-bottom: 24rpx;
}

.card-head {
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
}

.card-sub {
  display: block;
  margin-top: 6rpx;
  color: #999999;
  font-size: 21rpx;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 22rpx;
  height: 84rpx;
  margin-bottom: 22rpx;
  border-radius: 14rpx;
  background: #f7f7f9;
}

.addr-input {
  flex: 1;
  min-width: 0;
  color: #333333;
  font-size: 26rpx;
}

.ph {
  color: #b8b8be;
  font-size: 25rpx;
}

.copy {
  flex-shrink: 0;
  color: #ec4141;
  font-size: 23rpx;
}

.reset {
  margin-top: 20rpx;
  color: #999999;
  font-size: 22rpx;
  text-align: center;
}

.tip-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tip {
  color: #666666;
  font-size: 23rpx;
  line-height: 1.65;
}

.row-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f7;
  color: #333333;
  font-size: 26rpx;
}

.row-item:first-of-type {
  border-top: none;
}

.row-value {
  color: #999999;
  font-size: 23rpx;
}
