.admin {
  padding-top: 24rpx;
}

.tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 26rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tab {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 12rpx;
  color: #666666;
  font-size: 26rpx;
  text-align: center;
}

.tab.active {
  background: #fdecec;
  color: #ec4141;
  font-weight: 600;
}

.loading {
  padding: 40rpx 0;
  color: #999999;
  font-size: 23rpx;
  text-align: center;
}

/* ==================== 看板 ==================== */
.stats-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 10rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 6rpx;
}

.stat-value {
  color: #333333;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  margin-top: 6rpx;
  color: #999999;
  font-size: 20rpx;
}

.tip-card {
  padding: 24rpx;
}

.tip-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.tip {
  color: #666666;
  font-size: 23rpx;
  line-height: 1.7;
}

/* ==================== 搜索 ==================== */
.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: #ffffff;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
}

.ph {
  color: #b8b8be;
  font-size: 24rpx;
}

.search-btn {
  flex-shrink: 0;
  color: #ec4141;
  font-size: 24rpx;
}

.song-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

/* ==================== 列表 ==================== */
.list {
  margin-top: 20rpx;
}

.user-item,
.song-item {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eeeeee;
}

.user-main,
.song-main {
  flex: 1;
  min-width: 0;
}

.user-name-row,
.song-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.user-name,
.song-name {
  min-width: 0;
  max-width: 300rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.user-sub,
.song-sub {
  display: block;
  margin-top: 6rpx;
  color: #999999;
  font-size: 21rpx;
}

.badge {
  flex-shrink: 0;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: #f2f2f4;
  color: #888888;
  font-size: 19rpx;
  line-height: 30rpx;
}

.badge.admin {
  background: #fdecec;
  color: #ec4141;
}

.badge.ok {
  background: #e8f7ee;
  color: #23a05a;
}

.badge.off {
  background: #f2f2f4;
  color: #999999;
}

.badge.recommend {
  background: #fff4e5;
  color: #d9822b;
}

.user-actions,
.song-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.mini-btn {
  padding: 8rpx 22rpx;
  border: 1rpx solid #e4e4e8;
  border-radius: 22rpx;
  color: #666666;
  font-size: 22rpx;
}

.mini-btn.danger {
  border-color: #f3c9c9;
  color: #ec4141;
}

.song-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eeeeee;
}
