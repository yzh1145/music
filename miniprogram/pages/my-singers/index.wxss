.singers-page {
  padding-top: 26rpx;
}

.head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 30rpx;
}

.head-title {
  font-size: 38rpx;
  font-weight: 700;
}

.head-count {
  color: #999999;
  font-size: 22rpx;
}

.loading {
  padding: 120rpx 0;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 34rpx 18rpx;
}

.singer {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eeeeee;
}

.name {
  max-width: 100%;
  margin-top: 12rpx;
  color: #333333;
  font-size: 24rpx;
  font-weight: 500;
}

.sub {
  margin-top: 4rpx;
  color: #999999;
  font-size: 19rpx;
}

.hint {
  margin-top: 40rpx;
  color: #b0b0b6;
  font-size: 21rpx;
  text-align: center;
}
