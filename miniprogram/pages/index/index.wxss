.home {
  padding-top: 20rpx;
}

/* ==================== 搜索入口 ==================== */
.search-entry {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  margin-bottom: 22rpx;
  padding: 0 26rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #b8b8be;
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #b8b8be;
  transform: rotate(45deg);
}

.search-placeholder {
  color: #b0b0b6;
  font-size: 25rpx;
}

/* ==================== 轮播 ==================== */
.banner {
  height: 248rpx;
  margin-bottom: 36rpx;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.banner-image {
  width: 100%;
  height: 100%;
  background: #dddddd;
}

/* ==================== 横向歌单 ==================== */
.h-scroll {
  width: 100%;
  white-space: nowrap;
}

.h-item {
  display: inline-block;
  width: 218rpx;
  margin-right: 20rpx;
  vertical-align: top;
  white-space: normal;
}

.h-item:last-child {
  margin-right: 0;
}

/* ==================== 歌曲面板 ==================== */
.song-panel {
  padding: 8rpx;
}

/* ==================== 歌手 ==================== */
.singer-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 26rpx 18rpx;
}

.singer {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.singer-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eeeeee;
}

.singer-name {
  max-width: 100%;
  margin-top: 12rpx;
  color: #333333;
  font-size: 24rpx;
  font-weight: 600;
}

.singer-sub {
  max-width: 100%;
  margin-top: 4rpx;
  color: #999999;
  font-size: 19rpx;
  text-align: center;
}

/* ==================== 骨架 ==================== */
.banner-skeleton {
  height: 248rpx;
  margin-bottom: 36rpx;
  border-radius: 18rpx;
}

.title-skeleton {
  width: 180rpx;
  height: 36rpx;
  margin-bottom: 24rpx;
}

.skeleton-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.skeleton-grid-item {
  flex: 1;
  min-width: 0;
}

.cover-skeleton {
  width: 100%;
  height: 210rpx;
  border-radius: 16rpx;
}

.line-skeleton {
  width: 80%;
  height: 26rpx;
  margin-top: 14rpx;
}

.panel-skeleton {
  height: 360rpx;
  border-radius: 20rpx;
}
