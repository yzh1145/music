.square {
  padding-top: 26rpx;
}

.head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 700;
}

.head-count {
  color: #999999;
  font-size: 22rpx;
}

.category-bar {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 26rpx;
}

.category {
  display: inline-block;
  margin-right: 14rpx;
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: #ffffff;
  color: #666666;
  font-size: 24rpx;
}

.category.active {
  background: #ec4141;
  color: #ffffff;
  font-weight: 500;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx 20rpx;
}
