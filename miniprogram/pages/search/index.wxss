.search-page {
  padding-top: 22rpx;
}

/* ==================== 搜索框 ==================== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  height: 74rpx;
  padding: 0 26rpx;
  border-radius: 37rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  border: 3rpx solid #b8b8be;
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #b8b8be;
  transform: rotate(45deg);
}

.input {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  color: #333333;
  font-size: 26rpx;
}

.ph {
  color: #b0b0b6;
  font-size: 25rpx;
}

.clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #e8e8ec;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
}

.search-btn {
  flex-shrink: 0;
  padding: 0 8rpx;
  color: #ec4141;
  font-size: 28rpx;
  font-weight: 500;
}

/* ==================== 历史 / 热门 ==================== */
.block {
  margin-bottom: 26rpx;
}

.card.block {
  padding: 22rpx 22rpx 12rpx;
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
}

.clear-all {
  color: #999999;
  font-size: 23rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  max-width: 100%;
  padding: 10rpx 24rpx;
  border-radius: 26rpx;
  background: #f5f5f7;
  color: #666666;
  font-size: 24rpx;
}

.chip.hot {
  background: #fdecec;
  color: #ec4141;
}

/* ==================== 结果 tabs ==================== */
.tabs {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tab {
  flex: 1;
  padding: 12rpx 4rpx;
  border-radius: 12rpx;
  color: #666666;
  font-size: 21rpx;
  text-align: center;
  white-space: nowrap;
}

.tab.active {
  background: #fdecec;
  color: #ec4141;
  font-weight: 600;
}

.loading {
  padding: 80rpx 0;
  color: #999999;
  font-size: 25rpx;
  text-align: center;
}

/* ==================== 结果列表 ==================== */
.song-panel {
  padding: 10rpx;
}

.grid {
  display: grid;
  gap: 28rpx 20rpx;
}

.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

.grid-4 {
  grid-template-columns: repeat(4, 1fr);
}

.singer {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.singer-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eeeeee;
}

.singer-name {
  max-width: 100%;
  margin-top: 12rpx;
  color: #333333;
  font-size: 23rpx;
}

.singer-sub {
  margin-top: 4rpx;
  color: #999999;
  font-size: 19rpx;
}

.album {
  min-width: 0;
}

.album-cover {
  width: 100%;
  height: 210rpx;
  border-radius: 12rpx;
  background: #eeeeee;
}

.album-name {
  display: block;
  margin-top: 10rpx;
  color: #333333;
  font-size: 24rpx;
}

.album-sub {
  display: block;
  margin-top: 4rpx;
  color: #999999;
  font-size: 20rpx;
}
